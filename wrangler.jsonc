// Cloudflare Workers Builds deploys this repo with `npx wrangler deploy` on every push to main (no build step).
// The Worker serves the desk's read-only phone app, which GitHub Actions publishes to GitHub Pages, from
// Cloudflare: see deploy/cloudflare/worker.js. The name must match the Worker's name in the Cloudflare dashboard.
{
  "name": "quant-desk",
  "main": "deploy/cloudflare/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "vars": {
    "ORIGIN": "https://mrityurequest20-cyber.github.io/Quant-Desk"
  },
  "observability": { "enabled": true },
  // the desk's alarm clock (worker.js): ask GitHub to run scheduler.yml every 10 minutes, 07:30-15:20 IST, Mon-Fri.
  // Needs the Worker secret GH_DISPATCH_TOKEN; without it the trigger logs why and does nothing.
  "triggers": { "crons": ["*/10 2-9 * * 1-5"] }
}
