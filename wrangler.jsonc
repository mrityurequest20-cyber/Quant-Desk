// Cloudflare Workers Builds deploys this repo with `npx wrangler deploy` on every push to main (no build step).
// The Worker serves the desk's read-only phone app, which GitHub Actions publishes to GitHub Pages, from
// Cloudflare: see deploy/cloudflare/worker.js. The name must match the Worker's name in the Cloudflare dashboard.
{
  "name": "quant-desk",
  "main": "deploy/cloudflare/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "vars": {
    "ORIGIN": "https://mrityurequest20-cyber.github.io/Quant-Desk",
    // which broker's feed the live relay SHOWS for which kind of instrument (deploy/cloudflare/routes.js, docs/FEEDS.md); the same table as config/quantdesk.yaml feeds.routes (a test compares them)
    "FEED_ROUTES": "{\"idx\":[\"z\",\"k\"],\"eq\":[\"z\",\"k\"],\"fut\":[\"z\",\"k\"],\"opt\":[\"z\",\"k\"],\"mopt\":[\"f\",\"z\",\"k\"],\"copt\":[\"a\",\"f\",\"z\",\"k\"],\"mcx\":[\"f\",\"z\",\"k\"],\"cds\":[\"a\",\"f\",\"z\",\"k\"]}"
  },
  "observability": { "enabled": true },
  // The live price relay (deploy/cloudflare/live.js): one Durable Object holds the latest snapshot the Kite recorder pushes every 5 seconds.
  // It needs two Worker secrets, LIVE_INGEST_TOKEN (what the recorder sends) and LIVE_READ_TOKEN (the key typed once into the app's Live tab),
  // each at least 24 characters and different from each other; without them /live/* answers 503 and stores nothing.
  // A third secret, KOTAK_CONSUMER_KEY (the Kotak Neo market-data key, no orders), lets the same object poll Kotak itself on a Durable Object alarm every ~5 s
  // (deploy/cloudflare/kotak.js, docs/LIVE.md): the second live source, with no GitHub runner in its path. Without it the poller stays off.
  "durable_objects": { "bindings": [{ "name": "LIVE", "class_name": "LiveBoard" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveBoard"] }],
  // the desk's alarm clock (worker.js): ask GitHub to run scheduler.yml every 10 minutes, AROUND THE CLOCK, every day (8 Nov 2026, owner: nothing may be missed; news, the MCX evening and the
  // weekend checks all need it). Written as three crons that tile the 24 hours (UTC 02-09, 10-16, 17-23 and 00-01) so that no minute is fired twice: the watchdog runs inside each firing and its
  // slots are minute-exact, so two crons on one minute would send every alert twice. scheduler.py decides what, if anything, to start (nothing outside its windows).
  // Cloudflare numbers weekdays 1 = Sunday … 7 = Saturday (not 0 = Sunday), so any weekday in a cron is written by name: "1-5" here
  // meant Sunday-Thursday and skipped every Friday until 4 Oct 2026.
  // Also 15:25 and 15:45 IST Mon-Fri (09:55 and 10:15 UTC): start collect-wide.yml's stocks and minutes steps on time instead
  // of waiting for GitHub's cron, which has been hours late (F-19-2; the stock snapshot only exists while the book is live).
  // The watchdog (deploy/cloudflare/watchdog.js) runs inside these same firings (its slots are at times that are multiples of ten minutes).
  // Five cron triggers in all: the limit of Cloudflare's free plan, so any further check must reuse these patterns.
  // Needs the Worker secret GH_DISPATCH_TOKEN; without it the trigger logs why and does nothing.
  "triggers": { "crons": ["*/10 2-9 * * *", "*/10 10-16 * * *", "*/10 0-1,17-23 * * *", "55 9 * * MON-FRI", "15 10 * * MON-FRI"] }
}
